# Golang-dnssec-validator Configuration
# Copy this file to .env and customize as needed

# HTTP server listen address
LISTEN_ADDR=:8791

# Root trust anchors file path (from internet-files-mirror)
ROOT_ANCHORS_PATH=/etc/dnssec-validator/root-anchors.json

# Fallback URL for root trust anchors
ROOT_ANCHORS_URL=https://internet.any53.com/dns/anchors/root-anchors.json

# Per-server DNS query timeout
QUERY_TIMEOUT=5s

# Total validation timeout (all zones)
TOTAL_TIMEOUT=30s

# Maximum concurrent DNS queries
MAX_CONCURRENT=10

# Rate limiting: requests per second per IP
RATE_LIMIT_PER_SEC=10

# Rate limiting: burst size per IP
RATE_LIMIT_BURST=30

# Rate limiter cleanup interval
RATE_LIMIT_CLEANUP=5m

# Logging format: json or text
LOG_FORMAT=json

# Logging level: debug, info, warn, error
LOG_LEVEL=info

# Log file path (empty = stdout)
LOG_FILE=/var/log/tudordns/dnssec-validator.log

# Path to static web UI files (embedded in binary by default)
STATIC_DIR=./static

# Base path when behind reverse proxy (e.g., "/dnssec")
# Leave empty if served at root
BASE_PATH=

# Graceful shutdown timeout in seconds
SHUTDOWN_TIMEOUT_SECONDS=30
