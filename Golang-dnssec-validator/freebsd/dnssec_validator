#!/bin/sh
#
# PROVIDE: dnssec_validator
# REQUIRE: LOGIN
# KEYWORD: shutdown
#
# Add the following lines to /etc/rc.conf to enable dnssec_validator:
#
# dnssec_validator_enable="YES"
#
# Optional overrides (defaults shown):
# dnssec_validator_svcuser="dnssec-validator"
# dnssec_validator_command="/usr/local/sbin/dnssec-validator"
# dnssec_validator_logdir="/var/log/tudordns"
#
# Create the service user and log dir before starting:
#   pw useradd -n dnssec-validator -d /nonexistent -s /usr/sbin/nologin -c "DNSSEC Validator Service"
#   install -d -o dnssec-validator /var/log/tudordns
#
# Configuration is a TOML file the binary auto-discovers at
# /usr/local/etc/tudordns/dnssec-validator.toml -- no wrapper, no env file;
# see QUICKSTART-FREEBSD.md.

. /etc/rc.subr

name="dnssec_validator"
rcvar="${name}_enable"

load_rc_config $name

: ${dnssec_validator_enable:="NO"}
: ${dnssec_validator_svcuser:="dnssec-validator"}
: ${dnssec_validator_command:="/usr/local/sbin/dnssec-validator"}
: ${dnssec_validator_logdir:="/var/log/tudordns"}
: ${dnssec_validator_pidfile:="/var/run/${name}.pid"}

pidfile="${dnssec_validator_pidfile}"

# Privilege drop is done by `daemon -u` (below), NOT an su(1) wrapper, so the
# child pid daemon(8) records in ${pidfile} is the binary itself --
# status/stop/restart therefore act on the real listener. The old
# `daemon ... /usr/bin/su -m user -c wrapper` form recorded su's pid instead,
# which made `status` report "not running" while the daemon was live and made
# `stop` signal su rather than the binary (so a restart never cut over and a
# fresh start collided on the listen port). Using a non-magic *_svcuser var
# (not ${name}_user) keeps rc.subr from re-wrapping our custom commands in su.

start_cmd="${name}_start"
stop_cmd="${name}_stop"
status_cmd="${name}_status"
restart_cmd="${name}_restart"

dnssec_validator_start()
{
    if [ -f "${pidfile}" ] && kill -0 $(cat ${pidfile}) 2>/dev/null; then
        echo "${name} is already running as pid $(cat ${pidfile})"
        return 1
    fi

    # App writes its structured log under here (logging.file in the TOML).
    install -d -o ${dnssec_validator_svcuser} ${dnssec_validator_logdir}

    echo "Starting ${name}."
    /usr/sbin/daemon -p ${pidfile} -u ${dnssec_validator_svcuser} \
        -S -T ${name} ${dnssec_validator_command}
}

dnssec_validator_stop()
{
    if [ -f "${pidfile}" ] && kill -0 $(cat ${pidfile}) 2>/dev/null; then
        echo "Stopping ${name}."
        kill -TERM $(cat ${pidfile})
        wait_for_pids $(cat ${pidfile})
    else
        echo "${name} is not running."
    fi
    rm -f ${pidfile}
}

dnssec_validator_status()
{
    if [ -f "${pidfile}" ] && kill -0 $(cat ${pidfile}) 2>/dev/null; then
        echo "${name} is running as pid $(cat ${pidfile})"
    else
        echo "${name} is not running"
        return 1
    fi
}

dnssec_validator_restart()
{
    dnssec_validator_stop
    sleep 1
    dnssec_validator_start
}

run_rc_command "$1"
