#!/bin/sh
#
# PROVIDE: dnssec_validator
# REQUIRE: LOGIN
# KEYWORD: shutdown
#
# Add the following lines to /etc/rc.conf to enable dnssec_validator:
#
# dnssec_validator_enable="YES"
#

. /etc/rc.subr

name="dnssec_validator"
rcvar="dnssec_validator_enable"

load_rc_config $name

: ${dnssec_validator_enable:="NO"}

# Don't set dnssec_validator_user - rc.subr would add another su wrapper
# We handle user switching in command_args instead

pidfile="/var/run/${name}.pid"
procname="/usr/local/sbin/dnssec-validator"

# Use daemon(8) to properly daemonize, with wrapper to source env file
command="/usr/sbin/daemon"
command_args="-p ${pidfile} -S -T dnssec_validator /usr/bin/su -m dnssec-validator -c /usr/local/sbin/dnssec-validator.sh"

start_precmd="${name}_prestart"
stop_postcmd="${name}_poststop"

dnssec_validator_prestart()
{
    # Create log directory if needed (app writes to LOG_FILE from env)
    install -d -o dnssec-validator /var/log/tudordns

    # Pre-create pidfile writable by dnssec-validator user
    touch ${pidfile}
    chown dnssec-validator ${pidfile}
}

dnssec_validator_poststop()
{
    rm -f ${pidfile}
}

run_rc_command "$1"
