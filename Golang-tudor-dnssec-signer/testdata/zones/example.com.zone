$ORIGIN example.com.
$TTL 3600

@       IN      SOA     ns1.example.com. admin.example.com. (
                        2024011501      ; serial
                        3600            ; refresh
                        1800            ; retry
                        604800          ; expire
                        3600 )          ; minimum

@       IN      NS      ns1.example.com.
@       IN      NS      ns2.example.com.

@       IN      A       192.0.2.1
@       IN      AAAA    2001:db8::1

ns1     IN      A       192.0.2.2
ns2     IN      A       192.0.2.3

www     IN      A       192.0.2.1
www     IN      AAAA    2001:db8::1

mail    IN      A       192.0.2.10
@       IN      MX      10 mail.example.com.
