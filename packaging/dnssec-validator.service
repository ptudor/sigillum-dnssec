[Unit]
Description=Sigillum DNSSEC validation service
Documentation=https://github.com/ptudor/sigillum-dnssec
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dnssec-validator
Group=dnssec-validator
ExecStartPre=/usr/bin/dnssec-validator -check -config /etc/dnssec-validator/dnssec-validator.toml
ExecStart=/usr/bin/dnssec-validator -config /etc/dnssec-validator/dnssec-validator.toml
Restart=on-failure
RestartSec=5s
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
