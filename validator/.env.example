# Sigillum validator configuration
# Copy this file to .env and customize as needed

# HTTP server listen address
LISTEN_ADDR=:8791

# Root trust anchors file path (from internet-files-mirror)
ROOT_ANCHORS_PATH=/etc/dnssec-validator/root-anchors.json

# Fallback URL for root trust anchors
ROOT_ANCHORS_URL=https://internet.any53.com/dns/anchors/root-anchors.json

# Per-server DNS query timeout, in seconds
QUERY_TIMEOUT_SECONDS=5

# Total validation timeout (all zones), in seconds
TOTAL_TIMEOUT_SECONDS=30

# Maximum concurrent DNS queries
MAX_CONCURRENT=10

# Rate limiting: requests per second per IP
RATE_LIMIT_PER_SEC=10

# Rate limiting: burst size per IP
RATE_LIMIT_BURST=30

# Rate limiter cleanup interval, in seconds (300 = 5 minutes)
RATE_LIMIT_CLEANUP_SECONDS=300

# Logging format: json or text
LOG_FORMAT=json

# Logging level: debug, info, warn, error
LOG_LEVEL=info

# Log file path (empty = stdout)
LOG_FILE=/var/log/tudordns/dnssec-validator.log

# Path to static web UI files (embedded in binary by default)
STATIC_DIR=./static

# Base path when behind reverse proxy (e.g., "/dnssec")
# Leave empty if served at root
BASE_PATH=

# Comma-separated proxy CIDRs trusted to provide X-Forwarded-For / X-Real-IP.
# Keep this narrow (your reverse proxy/load balancer addresses only).
TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128

# Optional comma-separated CIDR allowlist for /metrics (empty = unrestricted)
METRICS_ALLOWED_CIDRS=

# Graceful shutdown timeout in seconds
SHUTDOWN_TIMEOUT_SECONDS=30

# ============================================================================
# AnyStatus Heartbeat Monitoring
# See ANYSTATUS.md for setup instructions
# ============================================================================

# Enable heartbeat monitoring (default: false)
HEARTBEAT_ENABLED=false

# Heartbeat endpoint URL (default shown, rarely needs changing)
HEARTBEAT_URL=https://www.any53.com/any53/anystatus/heartbeat/

# API key from AnyStatus registration (REQUIRED when enabled)
HEARTBEAT_API_KEY=

# Application identifier (must match registered app_key)
HEARTBEAT_APP=dnssec-validator

# URL to status page (shown as link on dashboard)
HEARTBEAT_STATUS_URL=/

# Instance identifier (defaults to hostname)
# Useful when running multiple instances
HEARTBEAT_INSTANCE_ID=

# Background heartbeat interval, in minutes (default: 5)
HEARTBEAT_INTERVAL_MINUTES=5
