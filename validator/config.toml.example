# DNSSEC Validator Configuration
# Copy to /usr/local/etc/sigillum-validator/config.toml and customize

# HTTP server settings
listen_addr = "127.0.0.1:8791"
shutdown_timeout_seconds = 30

# Root trust anchors
root_anchors_path = "/etc/sigillum-validator/root-anchors.json"
root_anchors_url = "https://internet.any53.com/dns/anchors/root-anchors.json"
# Last-known-good cache (absolute path in a directory the service can write,
# distinct from root_anchors_path; empty disables it). Every usable, pinned
# download is persisted here atomically and read before the network on later
# starts, so a restart while the mirror or network is down still validates.
root_anchors_cache_path = "/var/lib/sigillum-validator/root-anchors.json"

# DNS query settings
query_timeout_seconds = 5       # Per-server query timeout
total_timeout_seconds = 30      # Total validation timeout
max_concurrent = 10             # Max concurrent DNS queries
recursive_resolver = "127.0.0.1"  # Local recursive resolver for NS lookups (never a public/ad DNS)

# Outbound DNS egress policy (RA6X-054). Authoritative-server addresses come
# from DNS data the requesting client controls, so by default only public
# unicast destinations are dialled: loopback, link-local, private (RFC 1918,
# ULA, CGNAT), multicast and reserved addresses are refused. The
# recursive_resolver above is always allowed. Add CIDRs here for a private
# diagnostic deployment that must reach internal nameservers, or set
# allow_private_destinations = true for a deliberately internal instance.
# private_destination_allowlist = ["10.0.0.0/8", "fd00::/8"]
# allow_private_destinations = false

# The web UI is embedded in the executable. static_dir is deprecated.
# URL base path
base_path = ""                  # Base path for reverse proxy (e.g., "/dnssec")
trusted_proxy_cidrs = ["127.0.0.0/8", "::1/128"] # Only these CIDRs may set X-Forwarded-For / X-Real-IP
# /metrics is loopback-only by default (secure: Prometheus internals are not
# world-readable). To scrape from a monitoring host, list its CIDR here; to
# expose to everyone, use ["0.0.0.0/0", "::/0"]; an explicit [] removes all
# restriction.
metrics_allowed_cidrs = ["127.0.0.0/8", "::1/128"]

# Rate limiting
[rate_limit]
per_sec = 10                    # Requests per second per IP
burst = 30                      # Token bucket burst size
cleanup_seconds = 300           # Cleanup interval for stale entries (5 minutes)

# Logging
[logging]
level = "info"                  # debug, info, warn, error
format = "json"                 # text, json
file = ""                       # Log file path (empty = stdout)

# AnyStatus heartbeat monitoring (optional)
# See ANYSTATUS.md for setup instructions
[heartbeat]
enabled = false                 # Set to true after registering with AnyStatus
url = "https://www.any53.com/any53/anystatus/heartbeat/"
api_key = ""                    # Your API key from AnyStatus registration
app = "sigillum-validator"        # Must match app_key in AnyStatus
status_url = ""                 # URL to dashboard (shown on AnyStatus)
instance_id = ""                # Optional, defaults to hostname
interval_minutes = 5            # Background heartbeat interval
